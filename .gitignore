# Claude Code. Most of this directory is per-machine (conversations, caches, personal
# permission grants) and must not be shared — but the hooks and the preview-server config
# are project setup that every machine needs, and .claude/ being blanket-ignored is why the
# preview config had to be re-fixed by hand on a second machine.
.claude/*
!.claude/settings.json
!.claude/launch.json
files.zip
node_modules/
# Saved email exports (source material for design docs, e.g. "Mega prompt.eml") stay
# local: they carry mail headers, and an untracked in-scope file also poisons the build
# stamp's dirty check, stamping every local build one commit ahead of what CI rebuilds.
*.eml
cf/public/
.wrangler/
.env
.env.local
tools/.yt-candidates.json
tools/.yt-raw.json
tools/.kanji-cache.json
tools/.jmdict-cache.gz
tools/.freqlist-cache.txt

# Secrets never belong in the repo — they live in Cloudflare's secret store
# (`wrangler secret put`), which is encrypted and not readable back. These patterns are a
# backstop for the times a key gets pasted into a file "just for a second".
*api*key*.txt
*api*key*.json
*.key
secrets.*
**/apikey*

# Extracted textbook text. The PDFs are Matthew's licensed copies of a Routledge title;
# their contents do not belong in a public repo. tools/book-readings.mjs regenerates the
# reading dictionary from them on demand, so nothing here is load-bearing.
tools/.glossary-cache.html
*.book.txt
books/

# Textbook-derived content. Matthew owns the books; the repo is public, and committing
# these would publish them. The build mirrors this into cf/public/ (also ignored) so
# Cloudflare serves it — the app gets the content, git never does.
# Regenerate: node tools/build-scripts-asset.mjs <dir with pdftotext output>
data/private/

# Scraped course-website pages and the scenes parsed out of them. Same reasoning as the
# block above: this is the publisher's script text, and the repo is public. The cache only
# spares the site a re-fetch, and tools/scrape-scripts.mjs rebuilds it from scratch.
# Regenerate: node tools/scrape-scripts.mjs > data/private/scripts-web.json
tools/.site-cache/
tools/.annot-cache/
tools/.scrape.log
